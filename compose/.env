# Configuración de la PoC HCEN. Completar la contraseña y verificar la URL pública.
# Las contraseñas de los certificados se guardan aparte, en compose/.env.mtls.

# Base de datos local. Completar POSTGRES_PASSWORD antes del primer arranque.
POSTGRES_USER=hapi
POSTGRES_PASSWORD=

# Imagen del servidor FHIR. La versión y su digest corresponden al mismo artefacto.
HAPI_VERSION=v8.12.0-1
HAPI_DIGEST=d7f38d3676900b07e8a7d3500426eaf8d90ea9ced9a6726416f080f68e230fb0
GATEWAY_VERSION=1.0.0

# Dirección interna de Docker. Los clientes utilizan GATEWAY_PUBLIC_BASE_URL.
HAPI_BASE_URL=http://hapi-fhir:8080/fhir

# Tiempo máximo de espera de una llamada a HAPI, en segundos.
HAPI_TIMEOUT_SECONDS=30

# URL que recibirán los clientes en las respuestas. Su host debe figurar en el certificado.
GATEWAY_PUBLIC_BASE_URL=https://localhost:8080/fhir

# Entorno y autenticación preparados para la PoC. El cliente debe presentar su certificado.
GATEWAY_ENV=preprod
SECURITY_MODE=mtls

# Opciones heredadas del producto. Fusión y eliminación no forman parte del recorrido HCEN.
PIXM_REMOVE_PATIENT_ENABLED=false
PIXM_MERGE_REASSIGN_REFERENCES=true

# Máximo del envío completo, en MiB. Esta entrega utiliza 8 con validación activada.
MHD_MAX_BUNDLE_MB=8

# Habilita la publicación del documento FHIR utilizado por los ejemplos.
MHD_FHIR_DOCUMENT_PUBLISH_ENABLED=true

# Límite adicional del Bundle documental. No aumenta el límite del envío completo.
MHD_MAX_DOCUMENT_BUNDLE_MB=9

# ITI-65 crea al paciente ausente. Si ya existe, conserva sus datos. Mantener para CA-07.
MHD_PATIENT_CREATE_ENABLED=true

# Formato de la URL de recuperación que devuelve ITI-67. Esta entrega utiliza plataforma.
MHD_ATTACHMENT_URL_FORMAT=plataforma

# Identificador local usado cuando el documento no informa repository-id.
MHD_REPOSITORY_UNIQUE_ID=2.25.256589593566056775410682347957596112599

# Opciones del producto para recuperación. El tutorial publica documentos nuevos current.
MHD_RETRIEVE_SUPERSEDED=false
MHD_ACCESS_DENIED_STATUS=404

# Auditoría local. Un destino vacío utiliza el servidor HAPI de esta instalación.
AUDIT_ENABLED=true
AUDIT_REPOSITORY_URL=

# Valida los recursos antes de guardarlos. No desactivar para resolver errores de los ejemplos.
VALIDATION_ENABLED=true

# Dirección interna del servicio de validación.
VALIDATOR_BASE_URL=http://fhir-validator:8080/fhir-validator

# Espera máxima del Gateway al validador, en segundos.
VALIDATOR_TIMEOUT_SECONDS=30

# Tamaño máximo de respuesta del validador que lee el Gateway, en bytes.
VALIDATOR_MAX_RESPONSE_BYTES=4194304

# Imagen del validador distribuida, fijada por digest.
VALIDATOR_IMAGE=hcengenexus/ihe-gateway-validator-real:1.1.1@sha256:2b1bf9ee7791e1c514fa557e21842f844f35bb67e5d969fcee5f853688902baa

# Paquete en validator/igs. Al sustituirlo, actualizar SHA256SUMS y reiniciar fhir-validator.
IG_FILE=package.tgz

# Paquetes adicionales montados desde hapi/packages. Rutas dentro del contenedor.
IG_DEPENDENCIES=/packages/ihe.iti.mhd.tgz,/packages/hl7.terminology.r4-7.3.0.tgz,/packages/hl7.fhir.uv.extensions.r4-5.3.0.tgz,/packages/hl7.fhir.r4.core-4.0.1.tgz

# Memoria de la JVM del validador. Reservar memoria adicional para HAPI y el Gateway.
VALIDATOR_JAVA_SIZING=-Xms256m -Xmx3g -XX:MetaspaceSize=96M -XX:MaxMetaspaceSize=512m -Djboss.as.management.blocking.timeout=900

# Reduce determinados avisos de códigos no resolubles. Los bindings siguen validándose.
DISABLE_TERMINOLOGY=true

# Suprime ciertos avisos de bindings. La aceptación no acredita terminología completa.
SUPPRESS_BINDING_WARNINGS=true

# Permite extensiones desconocidas por el contexto del validador.
ANY_EXTENSIONS_ALLOWED=true

# Acceso local al validador. 127.0.0.1 evita publicarlo en otras interfaces del equipo.
VALIDATOR_PORT=127.0.0.1:8081

# Puerto HTTPS publicado. Debe concordar con la URL pública y la configuración del cliente.
GATEWAY_PORT=8080

# Límite de peticiones al acceso publicado del validador y ráfaga permitida.
VALIDATOR_RATE_LIMIT=20r/s
VALIDATOR_RATE_BURST=40

# Redes adicionales autorizadas en ese acceso. Vacío conserva la configuración local.
VALIDATOR_ALLOWED_EXTRA_CIDRS=

# Puerto de salud interno del contenedor. No es la base FHIR del cliente.
MANAGEMENT_PORT=8090

# Utiliza el validador real para los casos del tutorial.
COMPOSE_PROFILES=real
